# Copy to `apps/admin/.env` and fill in real values for local development. It is loaded
# automatically on start; a variable already set in the environment wins over the file. Every key
# here is read by `src/env.ts`; a variable missing from this file is a variable the loader doesn't
# know about.

# Postgres connection string. Required. The value below matches the docker-compose service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Better Auth's signing secret. Required only by `create-user`, which hashes a credential the
# running API must later accept, so it has to match the API's own AUTH_SECRET.
AUTH_SECRET=replace-with-a-generated-auth-secret-placeholder

# The origin `create-user`'s Better Auth configuration builds its own URLs from. Optional,
# defaults to http://localhost:3000.
AUTH_BASE_URL=http://localhost:3000

# S3-compatible object storage. Only `seed-exercises` needs these; they must match `apps/api`'s so
# the URLs the API hands out point at objects this command wrote.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wt-app
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Path-style addressing. MinIO needs it; real AWS tolerates it. Optional, defaults to true.
S3_FORCE_PATH_STYLE=true
