{
    "name": "@app/admin",
    "version": "0.0.1",
    "private": true,
    "bin": {
        "app-admin": "dist/main.js"
    },
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "start": "node dist/main.js",
        "test": "vitest run",
        "lint": "oxlint .",
        "format": "oxfmt --config ../../.oxfmtrc.json ."
    },
    "dependencies": {
        "@app/auth": "workspace:*",
        "@app/catalog": "workspace:*",
        "@app/db": "workspace:*",
        "@app/env": "workspace:*",
        "@app/errors": "workspace:*",
        "@app/image": "workspace:*",
        "@app/logger": "workspace:*",
        "@app/services": "workspace:*",
        "@app/storage": "workspace:*",
        "commander": "15.0.0",
        "dotenv": "17.4.2",
        "drizzle-orm": "0.45.2",
        "joi": "18.2.3"
    },
    "devDependencies": {
        "@app/tsconfig": "workspace:*",
        "@aws-sdk/client-s3": "3.1115.0",
        "@types/node": "26.2.0",
        "better-auth": "1.7.1",
        "testcontainers": "12.1.0",
        "typescript": "6.0.3",
        "vitest": "4.1.11"
    }
}
