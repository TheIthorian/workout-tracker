{
    "name": "@app/api",
    "version": "0.0.1",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json && concurrently --names tsc,api --prefix-colors blue,green --kill-others \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output dist/main.js\"",
        "start": "node dist/main.js",
        "test": "vitest run",
        "lint": "oxlint .",
        "format": "oxfmt --config ../../.oxfmtrc.json ."
    },
    "dependencies": {
        "@app/api-contract": "workspace:*",
        "@app/auth": "workspace:*",
        "@app/db": "workspace:*",
        "@app/env": "workspace:*",
        "@app/errors": "workspace:*",
        "@app/image": "workspace:*",
        "@app/logger": "workspace:*",
        "@app/nest-common": "workspace:*",
        "@app/services": "workspace:*",
        "@app/ssrf": "workspace:*",
        "@app/storage": "workspace:*",
        "@fastify/compress": "9.1.0",
        "@fastify/cookie": "11.0.2",
        "@fastify/cors": "11.3.0",
        "@fastify/multipart": "10.1.0",
        "@nestjs/common": "11.1.28",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.1.28",
        "@nestjs/platform-fastify": "11.1.28",
        "better-auth": "1.7.1",
        "dotenv": "17.4.2",
        "drizzle-orm": "0.45.2",
        "fastify": "5.12.5",
        "joi": "18.2.9",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@app/domain": "workspace:*",
        "@app/tsconfig": "workspace:*",
        "@aws-sdk/client-s3": "3.1115.0",
        "@nestjs/testing": "11.1.28",
        "@types/node": "26.2.0",
        "concurrently": "10.0.5",
        "pino": "10.3.1",
        "typescript": "6.0.3",
        "unplugin-swc": "1.5.11",
        "vitest": "5.0.3"
    }
}
