# Copy to `.env` and fill in real values for local development. Every key here is read by
# `src/config/load-env.ts`; a variable missing from this file is a variable the loader doesn't
# know about. See CLAUDE.md's "Configuration Management" section.

# Port the Fastify server listens on. Optional, defaults to 3000.
PORT=3000

# One of development | production | test. Optional, defaults to development.
NODE_ENV=development

# Minimum level the logger emits at. Optional, defaults to info.
LOG_LEVEL=info

# Pretty-prints log lines for a human terminal instead of newline-delimited JSON. Optional,
# defaults to false.
LOG_PRETTY=true

# Redacts sensitive fields (auth headers, cookies, tokens) from log output. Optional, defaults
# to true - only turn this off for local debugging, never in a deployed environment.
LOG_REDACT=true

# Postgres connection string. Required. The value below matches the docker-compose service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Better Auth's signing secret for session tokens and cookies. Required. The value below is NOT a
# real secret - generate your own with `openssl rand -base64 48` for anything but a disposable
# local database.
AUTH_SECRET=replace-with-a-generated-auth-secret-placeholder

# The origin Better Auth builds its own URLs and cookie attributes from. Required.
AUTH_BASE_URL=http://localhost:3000

# Comma-separated origins Better Auth accepts cross-origin auth requests from. Optional. Include
# the web app's dev server.
AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Forces the session cookie's Secure attribute. Optional. Leave unset locally (plain HTTP);
# set it to true in any deployment behind a TLS-terminating proxy.
# AUTH_SECURE_COOKIES=true

# Origin allowed to make cross-origin requests to this API. Optional, defaults to *.
CORS_ORIGIN=http://localhost:5173

# The three origins every response's links are built from. All required: a wrong origin produces
# links that look right and 404 for whoever follows them.
WEB_APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
MCP_BASE_URL=http://localhost:3100

# Base URI every RFC 7807 problem body's `type` is built from. Optional. Set it to your own domain
# in a real deployment - the packaged default is a placeholder.
# PROBLEM_TYPE_BASE=https://api.example.com/errors

# OpenAI-compatible chat endpoint. All optional: a blank LLM_API_KEY is a supported "LLM disabled"
# deployment, not a misconfiguration. Named LLM_* rather than OPENAI_* deliberately - the endpoint
# defaults to OpenRouter, and the OpenAI SDK reads OPENAI_API_KEY itself, which would let a silent
# fallback mask a wiring bug.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# S3-compatible object storage. The bucket and its credentials are REQUIRED - exercise guide images
# are uploaded to and served from this bucket, so the API refuses to boot without them. The values
# below match the docker-compose MinIO service.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=app-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Path-style addressing. MinIO needs it; real AWS tolerates it. Optional, defaults to true.
S3_FORCE_PATH_STYLE=true
