# Omit or leave empty in dev to use the Vite proxy (UI origin -> http://localhost:3000).
# Set a full URL to call the API directly.
# VITE_API_BASE_URL=http://localhost:3000

# Optional: the Vite dev proxy's target, when it differs from VITE_API_BASE_URL.
# VITE_API_PROXY_TARGET=http://localhost:3000

# Optional analytics. Leave unset to run without PostHog.
# VITE_PUBLIC_POSTHOG_KEY=
# VITE_PUBLIC_POSTHOG_HOST=

# Optional: the public origin of this deployment, e.g. https://forma.example.com.
# Used to make the canonical link and social preview meta tags absolute.
# VITE_SITE_URL=
