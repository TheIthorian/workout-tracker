# apps/mcp's environment. Deliberately smaller than apps/api's: every tool, and session resolution
# itself, reaches apps/api over HTTP, so this process holds no database connection, no Better Auth
# secret, no cookie configuration and no object-storage or LLM credentials.

# Port the MCP server listens on. Optional, defaults to 3100 - a different default from apps/api's
# 3000 so both can run locally at once.
PORT=3100

# development | production | test. Optional, defaults to development.
NODE_ENV=development

# trace | debug | info | warn | error | fatal. Optional, defaults to info.
LOG_LEVEL=info
LOG_PRETTY=true
LOG_REDACT=true

# The origins every tool result's `webUrl` and `resourceUrl` are built from
# (`ResourceUrlGenerator`, packages/nest-common). All required, and all must match apps/api's values
# so a resource reached through a tool carries the same links as one reached through the API.
WEB_APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
# Origin this process sends its own REST calls to - including resolving a connecting token's session
# (`GET /me/mcp-session`). Optional, defaults to API_BASE_URL above - only set it separately when the
# address this process dials differs from the public origin (behind a service mesh, a sidecar
# proxy, etc).
# API_INTERNAL_BASE_URL=http://localhost:3000
# This server's own public origin - apps/api builds the `mcpUrl` pointing here, and it must match.
MCP_BASE_URL=http://localhost:3100

# Base URI every problem body's `type` is built from. MCP tools return problem bodies to the client
# as the tool result, so this must match apps/api's value - otherwise a client matching on the
# `type` URI sees two different identifiers for the same error.
PROBLEM_TYPE_BASE=https://api.wtapp.com/errors
