{
    "name": "@app/mcp",
    "version": "0.0.1",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json && concurrently --names tsc,mcp --prefix-colors blue,green --kill-others \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output dist/main.js\"",
        "start": "node dist/main.js",
        "test": "vitest run",
        "lint": "oxlint .",
        "format": "oxfmt --config ../../.oxfmtrc.json ."
    },
    "dependencies": {
        "@app/api-client": "workspace:*",
        "@app/api-contract": "workspace:*",
        "@app/auth": "workspace:*",
        "@app/env": "workspace:*",
        "@app/errors": "workspace:*",
        "@app/logger": "workspace:*",
        "@app/nest-common": "workspace:*",
        "@modelcontextprotocol/sdk": "1.30.0",
        "@nestjs/common": "11.1.28",
        "@nestjs/core": "11.1.28",
        "@nestjs/platform-fastify": "11.1.28",
        "dotenv": "17.4.2",
        "fastify": "5.12.0",
        "joi": "18.2.3",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@app/db": "workspace:*",
        "@app/services": "workspace:*",
        "@app/tsconfig": "workspace:*",
        "@nestjs/testing": "11.1.28",
        "@testcontainers/postgresql": "12.1.0",
        "@types/node": "26.2.0",
        "concurrently": "10.0.5",
        "pino": "10.3.1",
        "testcontainers": "12.1.0",
        "typescript": "6.0.3",
        "unplugin-swc": "1.5.11",
        "vitest": "4.1.10"
    }
}
