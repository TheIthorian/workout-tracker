{
    "name": "@app/nest-common",
    "version": "0.0.1",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "test": "vitest run",
        "lint": "oxlint .",
        "format": "oxfmt --config ../../.oxfmtrc.json ."
    },
    "dependencies": {
        "@app/errors": "workspace:*",
        "@app/logger": "workspace:*",
        "@nestjs/common": "11.1.28",
        "@nestjs/core": "11.1.28",
        "reflect-metadata": "0.2.2",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@app/auth": "workspace:*",
        "@app/tsconfig": "workspace:*",
        "@types/node": "26.2.0",
        "fastify": "5.12.5",
        "pino": "10.3.1",
        "typescript": "6.0.3",
        "vitest": "5.0.5"
    }
}
