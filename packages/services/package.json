{
    "name": "@app/services",
    "version": "0.0.1",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "test": "vitest run",
        "lint": "oxlint .",
        "format": "oxfmt --config ../../.oxfmtrc.json ."
    },
    "dependencies": {
        "@app/api-contract": "workspace:*",
        "@app/auth": "workspace:*",
        "@app/catalog": "workspace:*",
        "@app/db": "workspace:*",
        "@app/domain": "workspace:*",
        "@app/errors": "workspace:*",
        "@app/ssrf": "workspace:*",
        "@app/storage": "workspace:*",
        "drizzle-orm": "0.45.2"
    },
    "devDependencies": {
        "@app/logger": "workspace:*",
        "@app/tsconfig": "workspace:*",
        "@aws-sdk/client-s3": "3.1115.0",
        "@types/node": "26.2.0",
        "testcontainers": "12.1.0",
        "typescript": "6.0.3",
        "vitest": "5.0.5"
    }
}
