{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "24",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL", "TESTCONTAINERS_RYUK_DISABLED"]
    },
    "lint": {},
    "//#typecheck": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
